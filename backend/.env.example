PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/amdox_erp
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Number of proxies in front of the server (Render = 1). Defaults to 1 in production, off otherwise.
# TRUST_PROXY=1
# Sign-up closes after the first (Admin) account. Set to true only to let anyone create an Employee account.
# ALLOW_PUBLIC_REGISTRATION=false
# Login/register attempts allowed per IP every 15 minutes
# AUTH_RATE_LIMIT=20
